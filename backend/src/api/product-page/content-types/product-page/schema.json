{
  "kind": "collectionType",
  "collectionName": "product_pages",
  "info": {
    "singularName": "product-page",
    "pluralName": "product-pages",
    "displayName": "Product Page",
    "description": "Editable content for each product detail page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "slug": {
      "type": "enumeration",
      "enum": ["monitors", "laptops", "aios", "nova", "matrix", "optima", "cases"],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "hero_eyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "hero_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "hero_subtitle": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "hero_cta_primary": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "hero_cta_secondary": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "lineup_eyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "lineup_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "models": {
      "type": "component",
      "repeatable": true,
      "component": "page.model-card",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "specs_eyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "specs_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "specs_label": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "spec_categories": {
      "type": "component",
      "repeatable": true,
      "component": "page.spec-category",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "extra": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
